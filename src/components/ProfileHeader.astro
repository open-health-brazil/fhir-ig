---
import { Badge } from '@astrojs/starlight/components';
import { getProfile, lastSegment, sourceLabel, sourceLink, type ProfileSource } from '../data/fhir';

interface Props {
	source: ProfileSource;
	id: string;
}

const profile = getProfile(Astro.props.source, Astro.props.id);
const statusVariant = profile.status === 'active' ? 'success' : profile.status === 'draft' ? 'caution' : 'danger';
const statusLabel = { active: 'ativo', draft: 'rascunho', retired: 'descontinuado' }[profile.status] ?? profile.status;
---

<div class="isb-profile-header not-content">
	<div class="isb-profile-title">
		<strong>{profile.title ?? profile.name}</strong>
		<Badge text={sourceLabel(profile)} variant={profile.source.kind === 'package' ? 'note' : 'tip'} />
		<Badge text={statusLabel} variant={statusVariant} />
	</div>
	<dl>
		<dt>Canônica</dt>
		<dd><code>{profile.url}</code></dd>
		{profile.version && (
			<>
				<dt>Versão do artefato</dt>
				<dd><code>{profile.version}</code></dd>
			</>
		)}
		<dt>Recurso</dt>
		<dd><code>{profile.type}</code> (deriva de <code>{lastSegment(profile.baseDefinition)}</code>)</dd>
		<dt>Fonte</dt>
		<dd><a href={sourceLink(profile)}>{profile.source.kind === 'package' ? 'Página do perfil no BR Core' : 'Perfil no Simplifier'}</a></dd>
	</dl>
</div>

<style>
	.isb-profile-header {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
		margin-block: 1rem;
	}
	.isb-profile-title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}
	dl {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.25rem 1rem;
		margin: 0;
		font-size: var(--sl-text-sm);
	}
	dt {
		color: var(--isb-muted);
	}
	dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	@media (max-width: 40rem) {
		dl {
			grid-template-columns: 1fr;
		}
		dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
