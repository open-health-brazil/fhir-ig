---
import Breakable from './Breakable.astro';
import { namingSystems } from '../data/fhir';

interface Props {
	/** NamingSystem ids from the terminologia package, in display order. */
	ids: string[];
}

const rows = Astro.props.ids.map((id) => {
	const ns = namingSystems.find((n) => n.id === id);
	if (!ns) throw new Error(`NamingSystem not found: ${id}`);
	return ns;
});
---

<div class="isb-table-wrap not-content">
	<table>
		<thead>
			<tr>
				<th>Identificador</th>
				<th><code>system</code> no BR Core</th>
				<th class="via2">URI legada (RNDS)</th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map((ns) => (
					<tr>
						<td>{ns.description ?? ns.name}</td>
						<td><code><Breakable text={ns.preferred} /></code></td>
						<td class="via2">{ns.legacy.length ? ns.legacy.map((u) => <code><Breakable text={u} /></code>) : '—'}</td>
					</tr>
				))
			}
		</tbody>
	</table>
</div>
<p class="isb-table-caption">Gerado a partir dos NamingSystems do pacote de terminologia.</p>

<style>
	.isb-table-wrap {
		overflow-x: auto;
		border: 1px solid var(--isb-form-ink);
		margin-top: 1rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--sl-text-sm);
	}
	th,
	td {
		text-align: left;
		padding: 0.5rem 0.75rem;
		vertical-align: top;
		border-bottom: 1px solid var(--isb-hair);
		border-inline-end: 1px solid var(--isb-hair);
	}
	th {
		background: var(--isb-paper-2);
		border-bottom-color: var(--isb-form-ink);
		font-family: var(--isb-font-display);
		font-stretch: 78%;
		font-weight: 650;
		font-size: 0.6875rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--isb-form-ink);
	}
	th code {
		font-size: inherit;
		text-transform: none;
		letter-spacing: 0;
	}
	.via2 {
		background: var(--isb-via2);
		color: var(--isb-via2-ink);
	}
	td code {
		display: block;
		overflow-wrap: break-word;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-xs);
	}
	.isb-table-caption {
		font-size: var(--sl-text-xs);
		color: var(--isb-muted);
	}
</style>
